int main() {
    SetConsoleOutputCP(CP_UTF8);
    SetConsoleCP(CP_UTF8);

    string text = "Проверка, один, два, три.";
    int M = 0;
    int N = 0;
    cout << "Введите начало удаления: " << endl;
    cin >> M;
    cout << "Введите конец удаления: " << endl;
    cin >> N;

    stringstream ss(text);
    string word;
    string result = "";
    int index = 1;

    while (ss >> word) {
        if (index < M || index > N) {
            if (!result.empty()) {
                result += "";
            }
            result += word;
        }
        index++;
    }
    
    cout << "Result: " << result;
    return 0;
}
